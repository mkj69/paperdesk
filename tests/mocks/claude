#!/usr/bin/env python3
"""Mock of the Claude Code CLI (`claude -p ...`) for PaperDesk tests.

Mimics the argument surface and the json / stream-json output formats closely
enough for the PaperDesk agent bridge to be exercised without network access.
"""
import json
import re
import os
import sys
import time
import uuid

VALUE_FLAGS = {
    "--output-format", "--model", "--resume", "-r", "--allowedTools", "--allowed-tools",
    "--disallowedTools", "--disallowed-tools", "--tools", "--permission-mode",
    "--append-system-prompt", "--system-prompt", "--input-format", "--max-turns",
    "--add-dir", "--session-id",
}
BOOL_FLAGS = {"-p", "--print", "--verbose", "--include-partial-messages",
              "--dangerously-skip-permissions", "-c", "--continue"}


def parse(argv):
    opts = {"print": False, "output_format": "text", "verbose": False,
            "partial": False, "model": "claude-mock", "resume": None, "prompt_args": []}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--print"):
            opts["print"] = True
        elif a == "--verbose":
            opts["verbose"] = True
        elif a == "--include-partial-messages":
            opts["partial"] = True
        elif a in BOOL_FLAGS:
            pass
        elif a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            if k == "--output-format":
                opts["output_format"] = v
            elif k == "--model":
                opts["model"] = v
            elif k in ("--resume",):
                opts["resume"] = v
        elif a in VALUE_FLAGS:
            v = argv[i + 1] if i + 1 < len(argv) else ""
            if a == "--output-format":
                opts["output_format"] = v
            elif a == "--model":
                opts["model"] = v
            elif a in ("--resume", "-r"):
                opts["resume"] = v
            i += 1
        elif a == "--version":
            print("2.1.329 (Claude Code mock)")
            sys.exit(0)
        else:
            opts["prompt_args"].append(a)
        i += 1
    return opts


def vocab_json(prompt):
    """Dictionary-lookup prompts ask for strict JSON."""
    m = re.search(r'(?:单词|生词|word)["”]?\s*[:：]\s*["“]?([A-Za-z][A-Za-z\-\' ]{0,60})', prompt)
    word = (m.group(1).strip() if m else "word")
    return json.dumps({"phonetic": "/ˈθɪŋ/", "pos": "n.", "meaning": f"（模拟释义）{word}：事物；东西",
                       "context_meaning": f"在本文语境中，{word} 指被讨论的对象",
                       "context_translation": "（模拟）这句话的中文翻译。"}, ensure_ascii=False)


def build_answer(prompt):
    if "JSON" in prompt or ("生词" in prompt and "归档" not in prompt and "总结" not in prompt):
        return vocab_json(prompt)
    if os.environ.get("MOCK_CLAUDE_FAIL"):
        return None
    if "翻译" in prompt or "Translate" in prompt or "translate" in prompt:
        # The text to translate is usually the last block of the prompt.
        src = prompt.strip().split("\n")[-1].strip()
        return "【译文】" + src[:40]
    head = " ".join(prompt.strip().split())[:30]
    ctx = ""
    if os.path.exists("paper.txt"):
        try:
            with open("paper.txt", encoding="utf-8") as f:
                n = len(f.read())
            ctx = f"我读取了 ./paper.txt，共 {n} 个字符。"
        except Exception:
            ctx = "paper.txt 存在但无法读取。"
    else:
        ctx = "当前目录没有 paper.txt。"
    archive = ("归档" in prompt) or ("总结" in prompt and "笔记" in prompt)
    if archive:
        return (
            "## 一句话总结\n这是一篇关于 **注意力机制** 的论文 (p.1)。\n\n"
            "## 方法\n缩放点积注意力除以 $\\sqrt{d_k}$ 以稳定梯度。\n\n"
            f"## 我的笔记要点\n- 已整合用户笔记。\n\n> 上下文：{ctx}\n"
        )
    return (
        f"关于「{head}」：\n\n"
        f"**核心观点**：点积会随维度增大，因此除以 $\\sqrt{{d_k}}$ 进行缩放 (p.1)。\n\n"
        f"{ctx}\n\n- 第一点：保持 softmax 不饱和\n- 第二点：梯度更稳定\n"
    )


def chunks(text, n):
    n = max(1, min(n, len(text)))
    size = -(-len(text) // n)
    return [text[i:i + size] for i in range(0, len(text), size)]


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def main():
    opts = parse(sys.argv[1:])
    stdin_text = ""
    if not sys.stdin.isatty():
        try:
            stdin_text = sys.stdin.read()
        except Exception:
            stdin_text = ""
    prompt = (stdin_text + "\n" + " ".join(opts["prompt_args"])).strip()
    if not prompt:
        sys.stderr.write("Error: Input must be provided either through stdin or as a prompt argument when using --print\n")
        sys.exit(1)

    if opts["resume"] and opts["resume"].startswith("bad"):
        sys.stderr.write(f"No conversation found with session ID: {opts['resume']}\n")
        sys.exit(1)

    session_id = opts["resume"] or str(uuid.uuid4())
    answer = build_answer(prompt)
    if answer is None:
        sys.stderr.write("API Error: mock failure\n")
        sys.exit(1)

    fmt = opts["output_format"]
    if fmt == "json":
        emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 120,
              "num_turns": 1, "result": answer, "session_id": session_id,
              "total_cost_usd": 0.0, "usage": {"input_tokens": 10, "output_tokens": len(answer)}})
        return
    if fmt != "stream-json":
        sys.stdout.write(answer + "\n")
        return
    if not opts["verbose"]:
        sys.stderr.write("Error: When using --print, --output-format=stream-json requires --verbose\n")
        sys.exit(1)

    emit({"type": "system", "subtype": "init", "session_id": session_id, "cwd": os.getcwd(),
          "model": opts["model"], "tools": ["Read", "Grep", "Glob"], "permissionMode": "default"})
    msg_id = "msg_" + uuid.uuid4().hex[:12]
    # A tool use, to exercise "status" handling.
    if os.path.exists("paper.txt"):
        emit({"type": "assistant", "session_id": session_id, "message": {
            "id": msg_id + "t", "role": "assistant", "model": opts["model"],
            "content": [{"type": "tool_use", "id": "toolu_1", "name": "Read",
                         "input": {"file_path": "paper.txt"}}]}})
        emit({"type": "user", "session_id": session_id, "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "toolu_1", "content": "(file contents)"}]}})
    if opts["partial"]:
        emit({"type": "stream_event", "session_id": session_id,
              "event": {"type": "message_start", "message": {"id": msg_id, "role": "assistant"}}})
        emit({"type": "stream_event", "session_id": session_id,
              "event": {"type": "content_block_start", "index": 0,
                        "content_block": {"type": "text", "text": ""}}})
        for part in chunks(answer, 4):
            time.sleep(0.05)
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_delta", "index": 0,
                            "delta": {"type": "text_delta", "text": part}}})
        emit({"type": "stream_event", "session_id": session_id,
              "event": {"type": "content_block_stop", "index": 0}})
        emit({"type": "stream_event", "session_id": session_id, "event": {"type": "message_stop"}})
    emit({"type": "assistant", "session_id": session_id, "message": {
        "id": msg_id, "role": "assistant", "model": opts["model"],
        "content": [{"type": "text", "text": answer}]}})
    emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 300,
          "num_turns": 2, "result": answer, "session_id": session_id, "total_cost_usd": 0.0})


if __name__ == "__main__":
    main()
